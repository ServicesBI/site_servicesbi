# ─── Ambiente ────────────────────────────────────────────────────────────────
# "development" (padrão) ou "production"
DJANGO_ENV=development

# ─── Segurança ───────────────────────────────────────────────────────────────
# Em produção: gere com → python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=django-insecure-dev-key-servicesbi-local

# ─── Debug ───────────────────────────────────────────────────────────────────
# Em produção SEMPRE "False"
DEBUG=True

# ─── Hosts permitidos ────────────────────────────────────────────────────────
# Em produção: seu domínio, ex: servicesbi.com.br,www.servicesbi.com.br
ALLOWED_HOSTS=127.0.0.1,localhost

# ─── CSRF trusted origins ────────────────────────────────────────────────────
# Em produção: https://servicesbi.com.br,https://www.servicesbi.com.br
CSRF_TRUSTED_ORIGINS=
